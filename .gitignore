# Ignore bundler config.
/.bundle

# Ignore all environment files (except templates and shared, non-secret defaults).
.env*
!.env.example
!.env.development

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any shared-disk uploads in production).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

# Ignore master key for decrypting credentials and more.
/config/master.key

/public/assets

# Node modules for Puppeteer (backoffice card rendering); Chromium is provisioned in the image.
/node_modules

# Claude Code settings (personal, not shared)
.claude/settings.json
.claude/settings.local.json
.claude/worktrees/

.codex/

# Operational notes that describe the live box's posture — hosting research, the
# concurrency/timeout/monitoring inventory, and the outstanding hardening list.
# Accurate and worth keeping; just not something to publish alongside the code.
/docs/HOSTING_NOTES.md
/docs/AVAILABILITY.md
.kamal/deploy.env
# R2 credentials for the off-site DB backup (bin/install-db-backups).
.kamal/backup.env

/app/assets/builds/*
!/app/assets/builds/.keep

# Compiled Flutter web bundle, served at /app. Materialised locally by bin/release-web (which
# builds it from the sibling carnevale/ repo) right before `kamal deploy`, the same "build fresh
# on the deploy machine" model as the LFS card images. Not committed: the minified output makes
# huge, noisy diffs and would drift from the frontend source it was built from.
/public/app

# macOS Finder artifacts.
.DS_Store
