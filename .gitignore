# Ignore bundler config.
/.bundle

# Ignore all environment files (except templates and shared, non-secret defaults).
.env*
!.env.example
!.env.development

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any shared-disk uploads in production).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

# Ignore master key for decrypting credentials and more.
/config/master.key

/public/assets

# Node modules for Puppeteer (backoffice card rendering); Chromium is provisioned in the image.
/node_modules

# Claude Code settings (personal, not shared)
.claude/settings.json
.claude/settings.local.json
.claude/worktrees/

.codex/

# Operational notes that describe the live box's posture — hosting research, the
# concurrency/timeout/monitoring inventory, and the outstanding hardening list.
# Accurate and worth keeping; just not something to publish alongside the code.
/docs/HOSTING_NOTES.md
/docs/AVAILABILITY.md
.kamal/deploy.env
# R2 credentials for the off-site DB backup (bin/install-db-backups).
.kamal/backup.env

/app/assets/builds/*
!/app/assets/builds/.keep

# Compiled Flutter web bundle, served at /app. Materialised locally by bin/release-web (which
# builds it from the sibling carnevale/ repo) right before `kamal deploy`. Not committed: the
# minified output makes huge, noisy diffs and would drift from the frontend source it was built
# from.
/public/app

# Rendered card faces — derived data, regenerable from the catalog and the illustrations by
# "Publish cards". They were committed via LFS until 2026-08-03, which cost ~67 MB in every
# clone and grew LFS storage by a fresh generation on each re-render. Deploys are unaffected:
# Kamal builds from the working tree, not `git archive`, and .dockerignore does not exclude
# this path — so the files still ship in the image as long as they exist on the deploy machine.
/public/cards

# macOS Finder artifacts.
.DS_Store
