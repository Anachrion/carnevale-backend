# Secrets are evaluated by Kamal at deploy time and passed to the containers.
# This file is safe to commit: it contains only *references* (env vars / commands),
# never the secret values themselves. It's also excluded from the Docker image.
#
# Before deploying, set these in your shell (or a local, git-ignored .env):
#   export KAMAL_REGISTRY_PASSWORD="ghp_...your GitHub PAT..."
#   export CARNEVALE_BACKEND_DATABASE_PASSWORD="$(openssl rand -hex 24)"   # generate once, keep it

# GitHub Container Registry token: a classic PAT with the `write:packages` scope.
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD

# Rails master key — decrypts config/credentials.yml.enc. Read straight from the file.
RAILS_MASTER_KEY=$(cat config/master.key)

# Postgres password. Used by BOTH the Rails app (to connect) and the Postgres
# accessory (to create the user), so the two must be the same value.
CARNEVALE_BACKEND_DATABASE_PASSWORD=$CARNEVALE_BACKEND_DATABASE_PASSWORD
POSTGRES_PASSWORD=$CARNEVALE_BACKEND_DATABASE_PASSWORD
