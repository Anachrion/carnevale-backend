<!DOCTYPE html>
<html class="h-full">
  <head>
    <title><%= content_for(:title) || "Backoffice" %> · Carnevale</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="icon" href="/icon.png" type="image/png">

    <%# The backoffice's shared furniture (.btn, .table-wrap, .pill, the editor's stat strip) lives
        in app/assets/tailwind/application.css — the screens not yet reworked still lean on it. %>
    <%= stylesheet_link_tag :tailwind, "data-turbo-track": "reload" %>
  </head>

  <body class="min-h-full bg-gray-50 font-sans text-gray-900 antialiased">
    <header class="flex items-center gap-6 bg-gray-900 px-6 py-3 text-gray-100">
      <%= link_to "Carnevale", backoffice_profiles_path,
            class: "text-sm font-semibold tracking-tight text-white no-underline" %>

      <%
        # The tab you are on is the one whose controller is rendering — worked out here rather than
        # passed in by every screen, so a new page cannot forget to light its own tab up.
        nav = {
          "Profiles"      => [ backoffice_profiles_path,      controller_name == "profiles" && action_name != "publish" ],
          "Weapons"       => [ backoffice_weapons_path,       controller_name == "weapons" ],
          "Special rules" => [ backoffice_special_rules_path, controller_name == "special_rules" ],
          "Publish cards" => [ publish_backoffice_profiles_path, action_name == "publish" ]
        }
      %>
      <nav class="flex items-center gap-1 text-sm">
        <% nav.each do |label, (path, current)| %>
          <%= link_to label, path,
                class: "rounded-md px-2.5 py-1.5 no-underline transition #{current ?
                  'bg-white/10 font-medium text-white' : 'text-gray-400 hover:bg-white/5 hover:text-gray-100'}" %>
        <% end %>
      </nav>

      <div class="ml-auto flex items-center gap-3">
        <% if respond_to?(:current_user) && current_user %>
          <span class="text-xs text-gray-400"><%= current_user.try(:username) || current_user.email %></span>
          <%= button_to "Sign out", destroy_user_session_path, method: :delete,
                class: "rounded-md border border-white/15 bg-white/5 px-2.5 py-1.5 text-xs text-gray-200 transition hover:bg-white/10 hover:text-white",
                form: { class: "inline" } %>
        <% end %>
      </div>
    </header>

    <main class="mx-auto max-w-6xl px-6 py-6">
      <% if notice.present? %><div class="flash notice"><%= notice %></div><% end %>
      <% if alert.present? %><div class="flash alert"><%= alert %></div><% end %>
      <%= yield %>
    </main>
  </body>
</html>
