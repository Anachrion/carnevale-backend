<% content_for :title, "Spells" %>

<h1>Spells</h1>

<%= form_with url: backoffice_spells_path, method: :get do |f| %>
  <div class="toolbar">
    <%= f.text_field :search, value: params[:search], placeholder: "Search by name…", class: "w-56" %>
    <span class="count"><%= @spells.size %> spell<%= "s" unless @spells.size == 1 %></span>
    <div class="ml-auto">
      <%= link_to "+ New spell", new_backoffice_spell_path, class: "btn btn-emerald" %>
    </div>
  </div>
<% end %>

<% @spells.group_by(&:discipline).each do |discipline, spells| %>
  <h2 style="margin-top:24px;"><%= discipline.humanize.titleize %></h2>
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th class="w-56">Name</th>
          <th class="text-right w-16">Cost</th>
          <th class="text-right w-20">Difficulty</th>
          <th>Description</th>
          <th class="text-center w-40">Used by</th>
          <th class="w-10"></th>
        </tr>
      </thead>
      <tbody>
        <% spells.each do |spell| %>
          <% chosen = @chosen[spell.id].to_i %>
          <% granted = @granted[spell.id].to_i %>
          <tr class="group">
            <td>
              <%= link_to spell.name, edit_backoffice_spell_path(spell) %>
              <% if spell.cantrip? %><span class="pill bg-indigo-50 text-indigo-700">Cantrip</span><% end %>
            </td>
            <td class="text-right tabular-nums"><%= spell.cost %></td>
            <td class="text-right tabular-nums"><%= spell.difficulty %></td>
            <td class="text-gray-500"><%= truncate(spell.description, length: 140).presence || "—" %></td>
            <td class="text-center text-xs text-gray-500">
              <%= chosen %> gang<%= "s" unless chosen == 1 %><% if granted.positive? %>, granted by <%= granted %><% end %>
            </td>
            <td class="text-center">
              <% if chosen.zero? && granted.zero? %>
                <%= button_to "🗑", backoffice_spell_path(spell), method: :delete,
                      class: "rounded p-1 text-gray-300 opacity-0 transition group-hover:opacity-100 " \
                             "hover:bg-red-50 hover:text-red-600 focus:opacity-100",
                      form: { class: "inline" },
                      data: { turbo_confirm: "Delete #{spell.name}? No gang or profile uses it." },
                      title: "Delete this unused spell" %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
