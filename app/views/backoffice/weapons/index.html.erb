<% content_for :title, "Weapons" %>

<h1>Weapons</h1>

<%= form_with url: backoffice_weapons_path, method: :get do |f| %>
  <div class="toolbar">
    <%= f.text_field :search, value: params[:search], placeholder: "Search by name…", class: "w-56" %>
    <span class="count"><%= @weapons.size %> weapon<%= "s" unless @weapons.size == 1 %></span>
    <div class="ml-auto">
      <%= link_to "+ New weapon", new_backoffice_weapon_path, class: "btn btn-emerald" %>
    </div>
  </div>
<% end %>

<%# The name is the way in, as on the profiles list. Deleting is offered only for a weapon nobody
    carries, and only on hover: it is the rare, irreversible one, not the one you came for. %>
<div class="table-wrap">
  <table>
    <thead>
      <tr>
        <th>Name</th>
        <th class="text-right">Damage</th>
        <th class="text-right">Evasion</th>
        <th class="text-right">Penetration</th>
        <th class="text-right">Range</th>
        <th>Abilities</th>
        <th class="text-center">Carried by</th>
        <th class="w-10"></th>
      </tr>
    </thead>
    <tbody>
      <% @weapons.each do |weapon| %>
        <% carried = @carried_by[weapon.id].to_i %>
        <tr class="group">
          <td><%= link_to weapon.name, edit_backoffice_weapon_path(weapon) %></td>
          <td class="text-right tabular-nums"><%= weapon.damage %></td>
          <td class="text-right tabular-nums"><%= weapon.evasion %></td>
          <td class="text-right tabular-nums"><%= weapon.penetration %></td>
          <td class="text-right tabular-nums"><%= weapon.range %></td>
          <td class="text-gray-500"><%= weapon.abilities.join(", ").presence || "—" %></td>
          <td class="text-center">
            <span class="pill bg-gray-100 text-gray-500">
              <%= carried %> profile<%= "s" unless carried == 1 %>
            </span>
          </td>
          <td class="text-center">
            <% if carried.zero? %>
              <%= button_to "🗑", backoffice_weapon_path(weapon), method: :delete,
                    class: "rounded p-1 text-gray-300 opacity-0 transition group-hover:opacity-100 " \
                           "hover:bg-red-50 hover:text-red-600 focus:opacity-100",
                    form: { class: "inline" },
                    data: { turbo_confirm: "Delete #{weapon.name}? No profile carries it." },
                    title: "Delete this unused weapon" %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
