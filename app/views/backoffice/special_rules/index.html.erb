<% content_for :title, "Special rules" %>

<h1>Special rules</h1>

<%= form_with url: backoffice_special_rules_path, method: :get do |f| %>
  <div class="toolbar">
    <%= f.text_field :search, value: params[:search], placeholder: "Search by name or spell…", class: "w-64" %>
    <span class="count"><%= @special_rules.size %> rule<%= "s" unless @special_rules.size == 1 %></span>
    <div class="ml-auto">
      <%= link_to "+ New special rule", new_backoffice_special_rule_path, class: "btn btn-emerald" %>
    </div>
  </div>
<% end %>

<div class="table-wrap">
  <table>
    <thead>
      <tr>
        <th class="w-56">Name</th>
        <th>Description</th>
        <th class="text-center">Spell</th>
        <th class="text-center">Carried by</th>
        <th class="w-10"></th>
      </tr>
    </thead>
    <tbody>
      <% @special_rules.each do |rule| %>
        <% carried = @carried_by[rule.id].to_i %>
        <tr class="group">
          <td>
            <%= link_to display_name(rule), edit_backoffice_special_rule_path(rule) %>
            <% if rule.name.blank? %>
              <div class="text-xs text-gray-400">printed under its spell name</div>
            <% end %>
          </td>
          <td class="text-gray-500"><%= truncate(rule.description, length: 90) %></td>
          <td class="text-center">
            <% if rule.spell_name.present? %>
              <span class="pill bg-violet-100 text-violet-800">
                <%= rule.spell_cost %>/<%= rule.spell_difficulty %>
              </span>
            <% else %>
              <span class="text-gray-300">—</span>
            <% end %>
          </td>
          <td class="text-center">
            <span class="pill bg-gray-100 text-gray-500">
              <%= carried %> profile<%= "s" unless carried == 1 %>
            </span>
          </td>
          <td class="text-center">
            <% if carried.zero? %>
              <%= button_to "🗑", backoffice_special_rule_path(rule), method: :delete,
                    class: "rounded p-1 text-gray-300 opacity-0 transition group-hover:opacity-100 " \
                           "hover:bg-red-50 hover:text-red-600 focus:opacity-100",
                    form: { class: "inline" },
                    data: { turbo_confirm: "Delete #{display_name(rule)}? No profile carries it." },
                    title: "Delete this unused special rule" %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
