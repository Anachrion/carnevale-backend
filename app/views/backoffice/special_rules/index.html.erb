<% content_for :title, "Special rules" %>

<h1>Special rules</h1>

<%= form_with url: backoffice_special_rules_path, method: :get do |f| %>
  <div class="toolbar">
    <%= f.text_field :search, value: params[:search], placeholder: "Search by name or spell…" %>
    <span class="count"><%= @special_rules.size %> rule<%= "s" unless @special_rules.size == 1 %></span>
    <div style="margin-left:auto;">
      <%= link_to "+ New special rule", new_backoffice_special_rule_path, class: "btn btn-emerald" %>
    </div>
  </div>
<% end %>

<div class="table-wrap">
  <table>
    <thead>
      <tr>
        <th style="width:220px;">Name</th>
        <th>Description</th>
        <th class="text-center">Spell</th>
        <th class="text-center">Carried by</th>
        <th class="text-center">Edit</th>
      </tr>
    </thead>
    <tbody>
      <% @special_rules.each do |rule| %>
        <tr>
          <td>
            <%= display_name(rule) %>
            <% if rule.name.blank? %>
              <div style="color:#9ca3af;font-size:12px;">printed under its spell name</div>
            <% end %>
          </td>
          <td style="color:#6b7280;"><%= truncate(rule.description, length: 90) %></td>
          <td class="text-center">
            <% if rule.spell_name.present? %>
              <span class="pill" style="background:#ede9fe;color:#5b21b6;">
                <%= rule.spell_cost %>/<%= rule.spell_difficulty %>
              </span>
            <% else %>
              —
            <% end %>
          </td>
          <td class="text-center">
            <% carried = @carried_by[rule.id].to_i %>
            <span class="pill" style="background:#f3f4f6;color:#6b7280;">
              <%= carried %> profile<%= "s" unless carried == 1 %>
            </span>
          </td>
          <td class="text-center">
            <%= link_to "✎ Edit", edit_backoffice_special_rule_path(rule), class: "btn" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
