<%# scope: :special_rule — the model is namespaced (default key would be catalog_special_rule). %>
<%= form_with model: special_rule, scope: :special_rule, url: url, method: method do |f| %>
  <% if special_rule.errors.any? %>
    <div class="flash alert"><%= special_rule.errors.full_messages.to_sentence %></div>
  <% end %>

  <div class="table-wrap" style="margin-top:16px;">
    <table>
      <tbody>
        <tr>
          <th style="width:170px;"><%= f.label :name %></th>
          <td>
            <%= f.text_field :name, style: "width:420px;" %>
            <div style="color:#6b7280;font-size:13px;">
              Leave blank only for a unique spell — the card then prints it under the spell's name.
            </div>
          </td>
        </tr>
        <tr>
          <th style="vertical-align:top;padding-top:14px;"><%= f.label :description %></th>
          <td><%= f.text_area :description, rows: 5, style: "width:100%;max-width:560px;" %></td>
        </tr>

        <tr><th colspan="2" style="background:#f9fafb;color:#6b7280;">Spell — leave empty if this rule is not one</th></tr>

        <tr>
          <th><%= f.label :spell_name, "Spell name" %></th>
          <td><%= f.text_field :spell_name, style: "width:420px;" %></td>
        </tr>
        <tr>
          <th><%= f.label :spell_cost, "Cost" %></th>
          <td><%= f.number_field :spell_cost, min: 0, style: "width:90px;" %></td>
        </tr>
        <tr>
          <th><%= f.label :spell_difficulty, "Difficulty" %></th>
          <td><%= f.number_field :spell_difficulty, min: 0, style: "width:90px;" %></td>
        </tr>
        <tr>
          <th style="vertical-align:top;padding-top:14px;"><%= f.label :spell_description, "Spell description" %></th>
          <td><%= f.text_area :spell_description, rows: 4, style: "width:100%;max-width:560px;" %></td>
        </tr>
      </tbody>
    </table>
  </div>

  <div class="toolbar" style="margin-top:16px;">
    <% unless special_rule.new_record? %>
      <% carried = special_rule.profiles.size %>
      <span style="color:#6b7280;font-size:13px;">
        Carried by <strong><%= carried %></strong> profile<%= "s" unless carried == 1 %> — saving marks
        every one of their cards out of date.
      </span>
    <% end %>

    <div style="margin-left:auto;display:flex;gap:8px;">
      <%= link_to "Cancel", backoffice_special_rules_path, class: "btn" %>
      <%= f.submit special_rule.new_record? ? "Create special rule" : "Save special rule", class: "btn btn-emerald" %>
    </div>
  </div>
<% end %>
