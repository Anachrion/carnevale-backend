<% content_for :title, "Profiles" %>

<%
  # Built from @filter, not params: the filter can come from the session (any bare visit to this
  # page replays it), and a sort link that read params would silently drop it.
  def sort_link(label, col, current_sort, current_dir, filter)
    next_dir = (current_sort == col && current_dir == "asc") ? "desc" : "asc"
    arrow = current_sort == col ? (current_dir == "asc" ? " ↑" : " ↓") : ""
    link_to "#{label}#{arrow}",
      backoffice_profiles_path(filter.slice("faction", "search").symbolize_keys.merge(sort: col, dir: next_dir))
  end
%>

<h1>Profiles</h1>

<%= form_with url: backoffice_profiles_path, method: :get do |f| %>
  <%= f.hidden_field :sort, value: @sort %>
  <%= f.hidden_field :dir,  value: @dir %>
  <div class="toolbar">
    <%= f.text_field :search, value: @filter["search"], placeholder: "Search by name…", class: "w-56" %>
    <%= f.select :faction,
          Catalog::Profile.factions.keys.map { |k| [ k.capitalize, k ] },
          { include_blank: "All factions", selected: @filter["faction"] },
          onchange: "this.form.requestSubmit()" %>
    <span class="count"><%= @profiles.size %> profile<%= "s" unless @profiles.size == 1 %></span>

    <div class="ml-auto flex gap-2">
      <%= link_to "+ New profile", new_backoffice_profile_path, class: "btn btn-emerald" %>
      <button type="button" id="btn-export-pdf" class="btn">⬇ PDF</button>
      <button type="button" id="btn-export-png" class="btn">⬇ PNG</button>
    </div>
  </div>
<% end %>

<!-- hidden export forms -->
<%= form_with url: export_pdf_backoffice_profiles_path, method: :get, id: "export-form", html: { style: "display:none" } do |f| %>
  <%= f.hidden_field :sort, value: @sort %>
  <%= f.hidden_field :dir,  value: @dir %>
<% end %>
<%= form_with url: export_png_backoffice_profiles_path, method: :get, id: "export-png-form", html: { style: "display:none" } do |f| %>
  <%= f.hidden_field :sort, value: @sort %>
  <%= f.hidden_field :dir,  value: @dir %>
<% end %>

<%#
  No Edit button per row: the name *is* the way in, as it is in every list people already use. The
  card view, which the name used to open, moves to a link that surfaces on hover — it is the thing
  you want occasionally, not the thing you came here to do.
%>
<div class="table-wrap">
  <table>
    <thead>
      <tr>
        <th><%= sort_link("Name", "name", @sort, @dir, @filter) %></th>
        <th>Faction</th>
        <th class="text-center">Version</th>
        <th class="w-10 text-center"><input type="checkbox" id="select-all" checked class="size-4 accent-gray-900"></th>
      </tr>
    </thead>
    <tbody>
      <% @profiles.each do |profile| %>
        <tr class="group">
          <td>
            <div class="flex items-center gap-2.5">
              <%= link_to profile.name, edit_backoffice_profile_path(profile),
                    title: "Edit the stats, with the card drawn live" %>
              <%# Hidden until the row is hovered, but never from the keyboard: focus brings it back. %>
              <%= link_to "Card ↗", card_backoffice_profile_path(profile, @filter), target: "_blank",
                    class: "rounded px-1 text-xs font-normal text-gray-400 opacity-0 transition " \
                           "group-hover:opacity-100 hover:!text-gray-900 focus:opacity-100 focus:outline-2" %>
            </div>
          </td>
          <td>
            <span class="pill" style="<%= faction_pill_style(profile.faction) %>"><%= profile.faction.capitalize %></span>
          </td>
          <td class="text-center"><%= card_versions(profile) %></td>
          <td class="text-center">
            <input type="checkbox" name="ids[]" value="<%= profile.id %>" checked
                   class="profile-checkbox size-4 accent-gray-900" form="export-form">
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<script>
(function() {
  const btnPdf     = document.getElementById('btn-export-pdf');
  const btnPng     = document.getElementById('btn-export-png');
  const selectAll  = document.getElementById('select-all');
  const checkboxes = document.querySelectorAll('.profile-checkbox');
  const pdfForm    = document.getElementById('export-form');
  const pngForm    = document.getElementById('export-png-form');

  btnPdf.addEventListener('click', function() { pdfForm.submit(); });

  btnPng.addEventListener('click', function() {
    pngForm.querySelectorAll('input[name="ids[]"]').forEach(el => el.remove());
    checkboxes.forEach(function(cb) {
      if (!cb.checked) return;
      const hidden = document.createElement('input');
      hidden.type = 'hidden';
      hidden.name = 'ids[]';
      hidden.value = cb.value;
      pngForm.appendChild(hidden);
    });
    pngForm.submit();
  });

  selectAll.addEventListener('change', function() {
    checkboxes.forEach(cb => { cb.checked = this.checked; });
  });

  checkboxes.forEach(cb => cb.addEventListener('change', function() {
    selectAll.checked = [...checkboxes].every(c => c.checked);
  }));
})();
</script>
