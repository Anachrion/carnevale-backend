    <div id="front-wrapper" style="display:flex;flex-direction:column;align-items:center;gap:12px;">
      <div style="display:flex;align-items:center;gap:8px;">
        <span style="font-family:'EB Garamond',serif;font-size:12px;letter-spacing:3px;text-transform:uppercase;color:rgba(255,255,255,0.72);">Front</span>
        <% if @profile.illustrations.any? %>
        <a id="edit-illus-link" href="<%= illustration_editor_backoffice_profile_path(@profile, (@query_params || {}).merge(number: 1)) %>" title="Edit illustration position" style="width:22px;height:22px;border-radius:50%;background:rgba(0,0,0,0.45);display:flex;align-items:center;justify-content:center;text-decoration:none;font-size:13px;">✎</a>
        <% end %>
        <% if @profile.illustrations.size > 1 %>
        <button id="btn-swap-illus" title="Next illustration" style="width:22px;height:22px;border-radius:50%;background:rgba(0,0,0,0.45);border:none;color:rgba(255,255,255,0.85);display:flex;align-items:center;justify-content:center;cursor:pointer;font-size:11px;padding:0;line-height:1;">⇄</button>
        <% end %>
      </div>
      <%= front_card_html %>
    </div>

    <!-- ============ BACK ============ -->
    <div id="back-wrapper" style="display:flex;flex-direction:column;align-items:center;gap:12px;">
      <span style="font-family:'EB Garamond',serif;font-size:12px;letter-spacing:3px;text-transform:uppercase;color:rgba(255,255,255,0.72);">Back</span>
      <%= back_card_html %>
    </div>

  </div>

  <div id="card-pdf-btn" style="display:flex;gap:10px;align-items:center;">
    <a href="<%= card_pdf_backoffice_profile_path(@profile) %>" style="display:inline-flex;align-items:center;gap:6px;padding:7px 14px;background:rgba(0,0,0,0.45);border-radius:6px;color:rgba(255,255,255,0.85);font-family:'EB Garamond',serif;font-size:13px;letter-spacing:.5px;text-decoration:none;" title="Download this card as PDF">⬇ PDF</a>
    <a href="<%= card_png_backoffice_profile_path(@profile, side: 'front') %>" style="display:inline-flex;align-items:center;gap:6px;padding:7px 14px;background:rgba(0,0,0,0.45);border-radius:6px;color:rgba(255,255,255,0.85);font-family:'EB Garamond',serif;font-size:13px;letter-spacing:.5px;text-decoration:none;" title="Download front as PNG">⬇ Front PNG</a>
    <a href="<%= card_png_backoffice_profile_path(@profile, side: 'back') %>" style="display:inline-flex;align-items:center;gap:6px;padding:7px 14px;background:rgba(0,0,0,0.45);border-radius:6px;color:rgba(255,255,255,0.85);font-family:'EB Garamond',serif;font-size:13px;letter-spacing:.5px;text-decoration:none;" title="Download back as PNG">⬇ Back PNG</a>
    <%= button_to "⇪ Render to catalog", render_to_catalog_backoffice_profile_path(@profile), method: :post,
          data: { turbo_confirm: "Render #{@profile.name} and overwrite its hosted card images (public/cards)?" },
          form: { style: "margin:0;" },
          style: "display:inline-flex;align-items:center;gap:6px;padding:7px 14px;background:#c4a24a;border:none;border-radius:6px;color:#1a1000;font-family:'EB Garamond',serif;font-size:13px;letter-spacing:.5px;text-decoration:none;cursor:pointer;",
          title: "Render both faces and publish them to the hosted catalog" %>
  </div>

</div>
<% end %>

<script>
  document.fonts.ready.then(function() {
    var el = document.getElementById('banner-name');
    if (!el) return;
    var maxWidth = 270;
    while (el.scrollWidth > maxWidth && parseFloat(el.style.fontSize) > 10) {
      el.style.fontSize = (parseFloat(el.style.fontSize) - 0.5) + 'px';
    }
  });

  document.addEventListener('keydown', function(e) {
    <% if @prev_profile_id %>
    if (e.key === 'ArrowLeft') window.location.href = '<%= card_backoffice_profile_path(@prev_profile_id, @query_params || {}) %>';
    <% end %>
    <% if @next_profile_id %>
    if (e.key === 'ArrowRight') window.location.href = '<%= card_backoffice_profile_path(@next_profile_id, @query_params || {}) %>';
    <% end %>
  });
</script>
</body>
</html>
