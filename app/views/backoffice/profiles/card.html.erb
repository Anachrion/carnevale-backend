<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= @profile.name %></title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="">
<link href="https://fonts.googleapis.com/css2?family=Pirata+One&family=EB+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600&display=swap" rel="stylesheet">
<style>
  @font-face {
    font-family: 'Buckingham';
    src: url('/fonts/Buckingham-Regular.woff') format('woff');
    font-weight: normal;
    font-style: normal;
  }
  body { margin: 0; box-sizing: border-box; }
  *, *::before, *::after { box-sizing: border-box; }

  @media print {
    @page { size: 70mm 120mm; margin: 0; }

    body > div {
      background: none !important;
      padding: 0 !important;
      min-height: 0 !important;
      display: block !important;
    }

    body > div > div { display: block !important; }

    #front-wrapper,
    #back-wrapper {
      display: block !important;
      width: 70mm !important;
      height: 120mm !important;
      overflow: hidden !important;
      break-after: page;
    }

    #card-pdf-btn { display: none !important; }

    #front-wrapper > :not(#front-card),
    #back-wrapper > :not(#back-card) { display: none !important; }

    #front-card,
    #back-card {
      zoom: 0.63;
      box-shadow: none !important;
      print-color-adjust: exact;
      -webkit-print-color-adjust: exact;
    }

    #front-card *,
    #back-card * {
      print-color-adjust: exact;
      -webkit-print-color-adjust: exact;
    }
  }
</style>
</head>
<body>
