<% content_for :title, @profile.name %>

<div style="display:flex;align-items:center;gap:12px;">
  <h1><%= @profile.name %></h1>
  <span class="pill" style="<%= faction_pill_style(@profile.faction) %>"><%= @profile.faction.capitalize %></span>
  <%= link_to "✎ Edit profile", edit_backoffice_profile_path(@profile), class: "btn", style: "margin-left:auto;" %>
  <%= link_to "Open card →", card_backoffice_profile_path(@profile), target: "_blank", class: "btn btn-indigo" %>
</div>

<div class="table-wrap" style="margin-top:16px;">
  <table>
    <tbody>
      <% {
        "Ducats" => @profile.ducats, "Movement" => @profile.movement, "Attack" => @profile.attack,
        "Dexterity" => @profile.dexterity, "Protection" => @profile.protection, "Mind" => @profile.mind,
        "Action points" => @profile.action_points, "Will points" => @profile.will_points,
        "Command points" => @profile.command_points, "Life points" => @profile.life_points,
        "Size" => @profile.size, "Version" => @profile.version
      }.each do |label, value| %>
        <tr>
          <th style="width:200px;"><%= label %></th>
          <td><%= value %></td>
        </tr>
      <% end %>
      <tr><th>Keywords</th><td><%= @profile.keywords.join(", ") %></td></tr>
      <tr><th>Abilities</th><td><%= @profile.abilities.join(", ") %></td></tr>
      <tr><th>Weapons</th><td><%= @profile.weapons.map(&:name).join(", ").presence || "—" %></td></tr>
      <tr><th>Special rules</th><td><%= @profile.special_rules.map(&:name).join(", ").presence || "—" %></td></tr>
    </tbody>
  </table>
</div>
