<% content_for :title, "Edit #{@profile.name}" %>

<div style="display:flex;align-items:center;gap:12px;">
  <h1>Edit <%= @profile.name %></h1>
  <span class="pill" style="<%= faction_pill_style(@profile.faction) %>"><%= @profile.faction.capitalize %></span>
  <%= link_to "← All profiles", backoffice_profiles_path, class: "btn", style: "margin-left:auto;" %>
  <%= link_to "Open card →", card_backoffice_profile_path(@profile), target: "_blank", class: "btn btn-indigo" %>
</div>

<%= render "form",
      profile: @profile,
      url: backoffice_profile_path(@profile),
      method: :patch,
      preview_url: card_preview_backoffice_profile_path(@profile) %>
