<%#
  The links every Devise screen offers, laid out as one row under the panel rather than a column of
  paragraphs. Which links appear is Devise's own logic, unchanged: no "Log in" on the log-in page,
  no "Forgot your password?" while resetting one.
%>
<% links = [] %>

<% if controller_name != "sessions" %>
  <% links << link_to("Log in", new_session_path(resource_name)) %>
<% end %>

<%# No "Sign up": the routes skip :registrations, so new_registration_path does not exist. The user
    model stays :registerable for the app's own API signup, so Devise's own condition would still
    offer the link — and it would raise. %>

<% if devise_mapping.recoverable? && !controller_name.in?([ "passwords", "registrations" ]) %>
  <% links << link_to("Forgot your password?", new_password_path(resource_name)) %>
<% end %>

<% if devise_mapping.confirmable? && controller_name != "confirmations" %>
  <% links << link_to("Didn't receive confirmation instructions?", new_confirmation_path(resource_name)) %>
<% end %>

<% if devise_mapping.lockable? && resource_class.unlock_strategy_enabled?(:email) && controller_name != "unlocks" %>
  <% links << link_to("Didn't receive unlock instructions?", new_unlock_path(resource_name)) %>
<% end %>

<% if devise_mapping.omniauthable? %>
  <% resource_class.omniauth_providers.each do |provider| %>
    <% links << button_to("Sign in with #{OmniAuth::Utils.camelize(provider)}",
                          omniauth_authorize_path(resource_name, provider), data: { turbo: false }) %>
  <% end %>
<% end %>

<% if links.any? %>
  <div class="auth-links">
    <%= safe_join(links, tag.span("·", class: "sep")) %>
  </div>
<% end %>
