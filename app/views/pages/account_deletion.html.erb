<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="all">
  <title>Account & Data Deletion — Carnevale Companion</title>
  <style>
    :root { color-scheme: light dark; }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      line-height: 1.65;
      color: #1a1a1a;
      background: #f7f7f8;
    }
    .wrap { max-width: 760px; margin: 0 auto; padding: 3rem 1.25rem 5rem; }
    h1 { font-size: 2rem; margin: 0 0 .25rem; }
    h2 { font-size: 1.25rem; margin: 2.25rem 0 .5rem; }
    .meta { color: #666; font-size: .9rem; margin-bottom: 2rem; }
    a { color: #2f6f4f; }
    ul, ol { padding-left: 1.25rem; }
    li { margin: .3rem 0; }
    .callout {
      background: rgba(47,111,79,.08);
      border: 1px solid rgba(47,111,79,.25);
      border-radius: 8px;
      padding: 1rem 1.25rem;
      margin: 1.25rem 0;
    }
    code { background: rgba(0,0,0,.06); padding: .1rem .35rem; border-radius: 4px; font-size: .9em; }
    footer { margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid rgba(0,0,0,.1); color: #666; font-size: .875rem; }
    @media (prefers-color-scheme: dark) {
      body { color: #e6e6e6; background: #17181a; }
