# Shared secret guard, meant to be *sourced*, not executed.
#
#   require_secrets VAR [VAR...]
#
# Secrets live in Infisical (project "carnevale", Production environment) and are
# injected by wrapping the whole script:
#
#     infisical run --env=prod -- bin/release-web --deploy
#
# This does not fetch anything itself — it only verifies that the wrapper was used,
# so a forgotten `infisical run` fails with a clear message instead of a confusing
# Kamal auth error further down. There is deliberately no fallback to a local env
# file: keeping secrets out of files on disk is the point of using Infisical, and a
# fallback would mask a broken setup rather than surface it.
require_secrets() {
  local var
  for var in "$@"; do
    if [ -z "${!var:-}" ]; then
      echo "error: $var is not set." >&2
      echo "       Run this via: infisical run --env=prod -- $0" >&2
      exit 1
    fi
  done
}
