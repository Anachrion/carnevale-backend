#!/usr/bin/env bash
# Build the Flutter web app and stage it for deployment at /app.
#
# The frontend lives in a separate repo (../carnevale by default). This script compiles its web
# build with the production API host baked in, then drops the output into public/app so the next
# `kamal deploy` ships it inside the image. public/app is gitignored: it is a build artifact, always
# regenerated here, never committed. Pass --deploy to run `kamal deploy` immediately afterwards.
#
# API_KEY is baked into the bundle at build time, so this must run under Infisical:
#   infisical run --env=prod -- bin/release-web --deploy
set -euo pipefail

BACKEND_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
FRONTEND_DIR="${CARNEVALE_FRONTEND_DIR:-$BACKEND_DIR/../carnevale}"

# shellcheck disable=SC1091
source "$BACKEND_DIR/bin/_load-secrets"

# The web bundle is served same-origin from Rails at carnevale-app.com/app/, so bake the SAME host
# it's served from. That makes /api/v1 calls same-origin — no CORS, no ALLOWED_ORIGINS needed.
# (Must stay one of config/deploy.yml proxy.hosts; use the primary domain, not the sslip.io host.)
API_HOST="carnevale-app.com"

if [[ ! -d "$FRONTEND_DIR" ]]; then
  echo "error: frontend repo not found at $FRONTEND_DIR" >&2
  echo "       set CARNEVALE_FRONTEND_DIR to override." >&2
  exit 1
fi

# Baked into the bundle so it can send X-Api-Key. A build without it produces a bundle the
# production backend rejects with 401 once API_KEY is set there, so require it up front rather
# than discovering it after a full Flutter build.
require_secrets API_KEY

echo "==> Building Flutter web (API_HOST=$API_HOST, base-href=/app/)"
(
  cd "$FRONTEND_DIR"
  flutter build web \
    --dart-define=API_HOST="$API_HOST" \
    --dart-define=API_USE_TLS=true \
    --dart-define=API_KEY="$API_KEY" \
    --base-href=/app/
)

echo "==> Staging build into public/app"
rm -rf "$BACKEND_DIR/public/app"
cp -r "$FRONTEND_DIR/build/web" "$BACKEND_DIR/public/app"

echo "==> Done. public/app is ready (served at https://$API_HOST/app/)."

if [[ "${1:-}" == "--deploy" ]]; then
  echo "==> Deploying with Kamal"
  cd "$BACKEND_DIR"
  # shellcheck disable=SC1091
  source bin/_load-secrets
  require_secrets KAMAL_REGISTRY_PASSWORD RAILS_MASTER_KEY CARNEVALE_BACKEND_DATABASE_PASSWORD
  kamal deploy
else
  echo "    Run 'infisical run --env=prod -- kamal deploy' to ship it, or re-run with --deploy."
fi
